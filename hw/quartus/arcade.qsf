# set_location_assignment FILL_FROM_TABLE -to VGA_R[6]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_R[7]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_G[0]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_G[1]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_G[2]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_G[3]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_G[4]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_G[5]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_G[6]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_G[7]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_B[0]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_B[1]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_B[2]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_B[3]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_B[4]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_B[5]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_B[6]   ;# Table 3-16
