set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY arcade_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "18:02:33  NOVEMBER 03, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan
# ---------------------------------------------------------------------------- #
# Arcade design files (#33). Package first (R-4.2.7).
# ---------------------------------------------------------------------------- #
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/arcade_regs_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/bridge_regs.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/tilemap_banks.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/tilemap_crop.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/tile_renderer_pipeline.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vga_timing.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vga_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/arcade_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE arcade_top.sv
set_global_assignment -name SDC_FILE arcade.sdc
# Generated by Platform Designer and the IP Catalog (README steps 1-2):
set_global_assignment -name QIP_FILE ../ip/arcade_soc/synthesis/arcade_soc.qip
set_global_assignment -name QIP_FILE ../ip/pixel_pll.qip

# ---------------------------------------------------------------------------- #
# FPGA pins (#33). Pin numbers: DE1-SoC Manual v1.2.2 rev E, CLOCK_50 from Table 3-5,
# VGA_* from Table 3-16 (cited by SRS CON-03 and §3.1.2.1). Fill in each FILL_FROM_TABLE
# by hand from the manual and uncomment the line; Quartus rejects the line until you do.
# I/O standard: 3.3 V for all VGA signals (§3.1.2.1).
# ---------------------------------------------------------------------------- #
# set_location_assignment FILL_FROM_TABLE -to CLOCK_50   ;# Table 3-5
# set_location_assignment FILL_FROM_TABLE -to VGA_R[0]   ;# Table 3-16
# set_location_assignment FILL_FROM_TABLE -to VGA_R[1]   ;# Table 3-16
